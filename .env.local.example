# Copy this file to .env.local for host-specific settings.

# Change published host ports without editing compose.yaml.
# COPILOT_WORKSPACE_FRONTEND_PORT=4173
# COPILOT_WORKSPACE_BACKEND_PORT=8001

# Enable passwordless sudo for the copilot user.
# ENABLE_PASSWORDLESS_SUDO=1

# Build the workspace from an ignored local Dockerfile.
# WORKSPACE_DOCKERFILE=Dockerfile.local
# WORKSPACE_BASE_IMAGE=copilot-workspace-docker/workspace-base:local

# Pin CLI versions locally when needed.
# COPILOT_CLI_VERSION=latest
# CLAUDE_CODE_VERSION=latest
